#!/bin/bash
set -e
/compose/wait
echo "Running Django migrations..."
python3 manage.py migrate --noinput
echo "Running ClickHouse migrations..."
python3 manage.py migrate_clickhouse
echo "Starting PostHog web server..."
exec granian --interface asgi --host 0.0.0.0 --port 8000 --workers 2 posthog.asgi:application
