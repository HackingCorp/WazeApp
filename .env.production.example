# =============================================================================
# WazeApp Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in all required values.
# NEVER commit .env.production to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=wazeapp
POSTGRES_USER=wazeapp
POSTGRES_PASSWORD=          # REQUIRED: Use a strong, unique password

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate secrets with: openssl rand -hex 32
JWT_SECRET=                 # REQUIRED: Main JWT signing secret
JWT_ACCESS_SECRET=          # REQUIRED: Access token signing secret
JWT_REFRESH_SECRET=         # REQUIRED: Refresh token signing secret

# -----------------------------------------------------------------------------
# OAuth Providers (optional, set to "disabled" to skip)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
FACEBOOK_APP_ID=disabled
FACEBOOK_APP_SECRET=disabled
MICROSOFT_CLIENT_ID=disabled
MICROSOFT_CLIENT_SECRET=disabled

# -----------------------------------------------------------------------------
# LLM / AI Providers (optional)
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=disabled
GROQ_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Analytics (PostHog - optional)
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# Payments (Stripe - optional)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
